{
  "name": "playtime-pact",
  "version": "0.60.8",
  "description": "자녀의 게임 플레이 시간을 관리하는 Electron 타이머 앱",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude tests/remoteApprovalBackend.test.mjs --exclude tests/remoteApprovalD1.test.mjs --exclude tests/remoteBackendMigrations.test.mjs --exclude tests/remoteBackendConfig.test.mjs --exclude tests/remoteBackendAuthority.test.mjs --exclude tests/remoteBackendControls.test.mjs --exclude tests/androidUpdateTooling.test.mjs --exclude tests/fcmProvider.test.mjs --exclude tests/remoteApprovalLifecycleE2E.test.mjs && node --test --test-concurrency=1 tests/remoteApprovalBackend.test.mjs tests/remoteApprovalD1.test.mjs tests/remoteBackendMigrations.test.mjs tests/remoteBackendConfig.test.mjs tests/remoteBackendAuthority.test.mjs tests/remoteBackendControls.test.mjs tests/androidUpdateTooling.test.mjs tests/fcmProvider.test.mjs tests/remoteApprovalLifecycleE2E.test.mjs",
    "package:win": "npm run package:win:signed",
    "package:win:unsigned": "electron-vite build && electron-builder --win --x64 --config electron-builder.config.cjs --config.win.forceCodeSigning=false --publish never",
    "package:win:signed": "node scripts/ensure-win-signing-configured.mjs && electron-vite build && electron-builder --win --x64 --config electron-builder.config.cjs --publish never && node scripts/verify-win-signature.mjs",
    "verify:win-signature": "node scripts/verify-win-signature.mjs",
    "update:sign": "node scripts/sign-android-update.mjs",
    "update:verify": "node scripts/verify-android-update.mjs",
    "remote:config:render": "npm --prefix remote-backend run config:render --",
    "remote:config:validate": "npm --prefix remote-backend run config:validate --",
    "remote:db:migrate": "npm --prefix remote-backend run db:migrate --",
    "remote:authority:bootstrap": "npm --prefix remote-backend run authority:bootstrap --",
    "remote:authority:verify": "npm --prefix remote-backend run authority:verify --",
    "remote:controls:get": "npm --prefix remote-backend run controls:get --",
    "remote:controls:set": "npm --prefix remote-backend run controls:set --",
    "remote:e2e": "node --test --test-concurrency=1 tests/remoteApprovalLifecycleE2E.test.mjs",
    "package:mac": "electron-vite build && electron-builder --mac",
    "release:baseline": "node scripts/create-release-payload-manifest.mjs --output .omo/evidence/project-completion/W4-T1 --require-release-config"
  },
  "build": {
    "appId": "com.playtimepact.desktop",
    "productName": "Playtime Pact",
    "executableName": "Playtime Pact",
    "icon": "resources/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Playtime Pact",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Playtime Pact"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "resources/icon-256.png"
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "42.5.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "vite": {
      "esbuild": "0.28.1"
    }
  },
  "dependencies": {
    "jose": "6.2.8",
    "koffi": "^3.1.4",
    "node-windows": "1.0.0-beta.8",
    "qrcode": "^1.5.4"
  }
}
